Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Handle direct existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Check if folder/index.html exists (e.g. /dashboard/customers -> /dashboard/customers/index.html)
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

# 3. Check if page.html exists (e.g. /dashboard/customers.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L]

# 4. Fallback to index.html for SPA client-side routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
